{
  "appId": "com.parkstay.bookings",
  "productName": "WA Stay",
  "copyright": "© 2025-2026 Wilson Waters",
  "asar": {
    "smartUnpack": false
  },
  "asarUnpack": [
    "node_modules/playwright-core/**",
    "node_modules/better-sqlite3/prebuilds/*.node"
  ],
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.d.ts",
    "!dist/**/*.map",
    "package.json",
    "node_modules/**/*",
    "!node_modules/better-sqlite3/{deps,src}/**",
    "!node_modules/better-sqlite3/prebuilds/*.node",
    "node_modules/better-sqlite3/prebuilds/${platform}-${arch}.node"
  ],
  "extraResources": [
    {
      "from": "resources/icons",
      "to": "icons",
      "filter": ["icon.png", "icon.ico", "email-logo.png"]
    }
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "resources/icons/icon.png",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.plist",
    "darkModeSupport": true,
    "minimumSystemVersion": "13.0.0",
    "type": "distribution",
    "artifactName": "WA-Stay-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "wilsonwaters",
      "repo": "wa-stay"
    }
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "title": "${productName} ${version}",
    "iconSize": 128,
    "window": {
      "width": 540,
      "height": 380
    },
    "backgroundColor": "#ffffff",
    "sign": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icons/icon.ico",
    "artifactName": "WA-Stay-Setup-${version}.${ext}",
    "requestedExecutionLevel": "asInvoker",
    "signtoolOptions": {
      "signingHashAlgorithms": ["sha256"]
    },
    "verifyUpdateCodeSignature": false,
    "publish": {
      "provider": "github",
      "owner": "wilsonwaters",
      "repo": "wa-stay"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "installerIcon": "resources/icons/icon.ico",
    "uninstallerIcon": "resources/icons/icon.ico",
    "installerHeader": "resources/icons/installer-header.bmp",
    "installerSidebar": "resources/icons/installer-sidebar.bmp",
    "uninstallerSidebar": "resources/icons/installer-sidebar.bmp",
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "${productName}",
    "perMachine": false,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "menuCategory": false,
    "displayLanguageSelector": false,
    "installerLanguages": ["en_US"],
    "language": "1033",
    "multiLanguageInstaller": false,
    "packElevateHelper": true,
    "differentialPackage": true,
    "include": "resources/installer.nsh"
  },
  "portable": {
    "artifactName": "WA-Stay-Portable-${version}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "rpm",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "resources/icons",
    "category": "Utility",
    "desktop": {
      "entry": {
        "Name": "WA Stay",
        "Comment": "Find and book places to stay across Western Australia",
        "Categories": "Utility;Office;",
        "Keywords": "camping;caravan;holiday;accommodation;parkstay;booking;",
        "StartupWMClass": "WA Stay"
      }
    },
    "artifactName": "WA-Stay-${version}-${arch}.${ext}",
    "synopsis": "Find and book places to stay across Western Australia",
    "description": "WA Stay is a desktop app for finding and booking places to stay across Western Australia, such as national-park campgrounds booked through ParkStay WA.",
    "maintainer": "wilsonwaters@users.noreply.github.com",
    "vendor": "WA Stay",
    "publish": {
      "provider": "github",
      "owner": "wilsonwaters",
      "repo": "wa-stay"
    }
  },
  "appImage": {
    "license": "LICENSE",
    "artifactName": "WA-Stay-${version}-${arch}.${ext}"
  },
  "deb": {
    "depends": [
      "gconf2",
      "gconf-service",
      "libnotify4",
      "libappindicator1",
      "libxtst6",
      "libnss3"
    ],
    "priority": "optional",
    "compression": "xz",
    "artifactName": "WA-Stay-${version}-${arch}.${ext}"
  },
  "rpm": {
    "depends": [
      "libnotify",
      "libappindicator-gtk3",
      "libXtst",
      "nss"
    ],
    "fpm": ["--rpm-compression", "xz"],
    "artifactName": "WA-Stay-${version}-${arch}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "wilsonwaters",
    "repo": "wa-stay"
  },
  "compression": "maximum",
  "removePackageScripts": true,
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "electronCompile": false,
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true,
    "enableCookieEncryption": true,
    "enableEmbeddedAsarIntegrityValidation": true
  },
  "extends": null
}
