{
  "name": "wa-stay",
  "productName": "WA Stay",
  "version": "1.2.0",
  "description": "Find and book places to stay across Western Australia",
  "main": "dist/main/main/index.js",
  "author": {
    "name": "Wilson Waters",
    "email": "wilsonwaters@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wilsonwaters/wa-stay.git"
  },
  "homepage": "https://github.com/wilsonwaters/wa-stay",
  "bugs": {
    "url": "https://github.com/wilsonwaters/wa-stay/issues"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "concurrently \"tsc -p tsconfig.main.json --watch\" \"tsc-alias -p tsconfig.main.json --watch\"",
    "dev:preload": "node scripts/build-preload.js --watch",
    "dev:renderer": "vite",
    "start": "cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron .",
    "start:electron": "electron .",
    "build": "node scripts/clean-dist.js && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:preload": "node scripts/build-preload.js",
    "build:renderer": "vite build",
    "build:e2e": "node scripts/build-e2e.js",
    "build:all": "npm run build && electron-builder -mwl",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build:win --publish never",
    "dist:mac": "npm run build:mac --publish never",
    "dist:linux": "npm run build:linux --publish never",
    "pack": "npm run build && electron-builder --dir",
    "preview": "vite preview",
    "pretest": "node scripts/check-native-abi.js",
    "test": "jest",
    "test:tz": "cross-env TZ=Australia/Perth jest tests/unit/database/timestamps.test.ts --selectProjects main",
    "pretest:watch": "node scripts/check-native-abi.js",
    "test:watch": "jest --watch",
    "pretest:coverage": "node scripts/check-native-abi.js",
    "test:coverage": "jest --coverage",
    "test:electron": "node tests/electron/run.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "smoke:packaged": "node scripts/packaged-smoke.js",
    "docs:screenshots": "node scripts/docs-screenshots.js",
    "provider:new": "node scripts/new-provider.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit && tsc -p tests/docs/tsconfig.json --noEmit",
    "icons": "node scripts/generate-icons.js",
    "clean": "rimraf dist release out coverage",
    "clean:all": "npm run clean && rimraf node_modules",
    "prepare": "husky",
    "release": "npm run build && electron-builder --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "release:linux": "npm run build && electron-builder --linux --publish always",
    "version:patch": "npm version patch && git push --tags",
    "version:minor": "npm version minor && git push --tags",
    "version:major": "npm version major && git push --tags"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12",
    "nodemailer": "10.0.14",
    "playwright-core": "1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "sanitize-html": "^2.18.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-notarize": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.55.0",
    "mapbox-gl": "^3.32.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "keywords": [
    "accommodation",
    "camping",
    "western-australia",
    "parkstay",
    "booking",
    "electron"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "build": {
    "extends": "./electron-builder.json"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
