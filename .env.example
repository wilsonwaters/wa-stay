# Copy to .env (gitignored) for local development.
#
# A public Mapbox token (starts with pk.) for Explore's map. Create one at
# https://account.mapbox.com/access-tokens/ with public scopes only: it is bundled into the
# app, where anyone can read it. A secret (sk.) token fails the build. Without a token,
# Explore shows places as a list.
MAPBOX_ACCESS_TOKEN=
